generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  out_of_stock
  low_stock
  in_stock
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  quantity    Int           @default(0)
  price       Decimal
  status      ProductStatus
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("products")
}